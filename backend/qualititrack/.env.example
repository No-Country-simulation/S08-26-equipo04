# PostgreSQL Neon - Obtener en https://console.neon.tech
DB_HOST=ep-calm-credit-acr8cprb-pooler.sa-east-1.aws.neon.tech
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=YOUR_NEON_PASSWORD_HERE

# JWT - Generar en https://jwtbuilder.io/ o similar
JWT_SECRET=YOUR_JWT_SECRET_HERE

# Auth0 / Security
PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE
USER_GENERATOR=CALIDAD

# Gateway - URLs de microservicios
MS_AUTH_URL=http://localhost:8081
MS_BUSINESS_URL=http://localhost:8082
MS_EXECUTION_URL=http://localhost:8084

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Servidor
PORT=8080

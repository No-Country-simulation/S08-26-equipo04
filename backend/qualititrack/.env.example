# Copiá este archivo como .env y completá los valores. El .env NUNCA se sube al repo.

# --- PostgreSQL (Neon u otro proveedor) ---
DB_HOST=<host>.neon.tech
DB_NAME=<database>
DB_USER=<usuario>
DB_PASSWORD=<password>

# --- JWT (compartido por ms-auth, ms-business y ms-execution) ---
# Generar con: openssl rand -base64 64
JWT_SECRET=<secreto-base64-de-al-menos-256-bits>
JWT_ISSUER=qualitytrack
JWT_EXPIRATION_MINUTES=30

# --- API Gateway: URLs de los microservicios (en Docker Compose se sobrescriben) ---
MS_AUTH_URL=http://localhost:8081
MS_BUSINESS_URL=http://localhost:8082
MS_EXECUTION_URL=http://localhost:8084

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Puerto del gateway ---
PORT=8080
